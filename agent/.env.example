# 复制为 .env；.env 不入库
DASHSCOPE_API_KEY=            # 百炼 API Key（只在这里出现；不进代码、事件、日志、提交）
AGENT_MODEL=qwen-plus         # 百炼 OpenAI 兼容接口的模型名
AGENT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ERP_BASE_URL=http://127.0.0.1:9100
ERP_API_KEY=east-demo-key     # 模拟 ERP 的租户 key（华东）；课程环境自带，不是秘密
AGENT_RUNS_DIR=runs           # 相对路径以 agent/ 为基准；默认不入库
AGENT_KNOWLEDGE_DIR=knowledge # 相对路径以 agent/ 为基准
AGENT_ARTIFACTS_DIR=artifacts # 相对路径以 agent/ 为基准
